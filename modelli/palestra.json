      { "id": "pagata", "nome": "Pagata", "tipo": "si_no" },
      { "id": "metodo", "nome": "Metodo", "tipo": "scelta", "opzioni": [ { "id": "contanti", "nome": "Contanti" }, { "id": "carta", "nome": "Carta" }, { "id": "bonifico", "nome": "Bonifico" } ] },
      { "id": "ricevuta", "nome": "Ricevuta n.", "tipo": "contatore", "formato": "R-{AAAA}-{N:4}" } ] }
