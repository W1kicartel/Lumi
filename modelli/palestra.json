    { "id": "abbonamento_scadenza", "nome": "Abbonamento mensile senza fine: scade dopo 30 giorni", "entita": "abbonamenti", "quando": "creato", "se": "VUOTO(al) E tipo = \"mensile\"",
      "azioni": [ { "tipo": "imposta", "campo": "al", "formula": "AGGIUNGIGIORNI(dal; 30)" } ] }
