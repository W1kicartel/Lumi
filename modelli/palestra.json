    { "id": "reception", "nome": "Reception", "entita": { "*": { "leggi": true, "crea": true, "modifica": true }, "corsi": { "crea": false, "modifica": false } } }
  ],
  "cruscotto": {
    "widget": [
      { "tipo": "numero", "titolo": "Abbonamenti attivi", "entita": "abbonamenti", "misura": "conta", "filtri": [{ "campo": "attivo", "op": "=", "valore": true }] },
      { "tipo": "numero", "titolo": "Incassato questo mese", "entita": "quote", "misura": "somma", "campo": "importo", "campoData": "data", "periodo": "mese", "filtri": [{ "campo": "pagata", "op": "=", "valore": true }] },
      { "tipo": "numero", "titolo": "Lezioni oggi", "entita": "lezioni", "misura": "conta", "campoData": "quando", "periodo": "oggi", "filtri": [{ "campo": "stato", "op": "!=", "valore": "annullata" }] },
      { "tipo": "numero", "titolo": "Nuovi soci questo mese", "entita": "soci", "misura": "conta", "campoData": "creato", "periodo": "mese" },
      { "tipo": "grafico", "titolo": "Quote incassate per mese", "entita": "quote", "misura": "somma", "campo": "importo", "campoData": "data", "periodo": "ultimi_365", "per": "mese", "forma": "barre", "filtri": [{ "campo": "pagata", "op": "=", "valore": true }], "largo": true }
    ],
    "attenzione": [
      { "titolo": "Abbonamenti che scadono entro 7 giorni", "entita": "abbonamenti", "filtri": [{ "campo": "al", "op": "tra", "valore": ["@oggi", "@oggi+7"] }] },
      { "titolo": "Certificati medici scaduti o mancanti", "entita": "soci", "filtri": [{ "campo": "certificato_ok", "op": "=", "valore": false }] },
      { "titolo": "Quote da incassare", "entita": "quote", "filtri": [{ "campo": "pagata", "op": "=", "valore": false }] },
      { "titolo": "Lezioni passate da chiudere", "entita": "lezioni", "filtri": [{ "campo": "quando", "op": "<", "valore": "@oggi" }, { "campo": "stato", "op": "=", "valore": "in_programma" }] }
    ]
  }
