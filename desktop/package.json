{
  "name": "lumi-desktop",
  "productName": "Lumi",
  "version": "0.2.0",
  "description": "Lumi, il gestionale open source: l'app per il PC che tiene i dati o che si collega a Lumi in rete",
  "license": "MIT",
  "author": "W1kicartel",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "prova": "electron . --prova",
    "icona": "node icona.mjs",
    "dist:mac": "node icona.mjs && electron-builder --mac --publish never",
    "dist:win": "node icona.mjs && electron-builder --win nsis --publish never",
    "dist:linux": "node icona.mjs && electron-builder --linux AppImage deb --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "it.lumi.gestionale",
    "productName": "Lumi",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.mjs", "server.mjs", "icona.mjs", "preload.cjs", "scelta.html", "scelta.js", "package.json"],
    "extraResources": [
      { "from": "../server", "to": "lumi/server" },
      { "from": "../web", "to": "lumi/web" },
      { "from": "../modelli", "to": "lumi/modelli" },
      { "from": "../package.json", "to": "lumi/package.json" },
      { "from": "../LICENSE", "to": "lumi/LICENSE" }
    ],
    "electronFuses": { "runAsNode": false, "enableNodeOptionsEnvironmentVariable": false, "enableNodeCliInspectArguments": false },
    "mac": { "category": "public.app-category.business", "target": [{ "target": "dmg", "arch": ["universal"] }], "artifactName": "Lumi-${version}-mac.${ext}",
      "extraResources": [{ "from": "bin", "to": "lumi/bin", "filter": ["lumi-voce"] }],
      "x64ArchFiles": "Contents/Resources/lumi/bin/lumi-voce",
      "extendInfo": { "NSMicrophoneUsageDescription": "Lumi usa il microfono solo mentre parli con l'assistente. Con la voce locale l'audio resta su questo computer." } },
    "win": { "target": "nsis", "artifactName": "Lumi-${version}-windows.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "runAfterFinish": true },
    "linux": { "target": ["AppImage", "deb"], "category": "Office", "artifactName": "Lumi-${version}-linux.${ext}" }
  }
}
